{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gatecost result",
  "type": "object",
  "required": ["schema_version", "tool", "command", "status", "result", "diagnostics"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "tool": {"const": "gatecost"},
    "command": {"type": "string"},
    "status": {"enum": ["ok", "partial", "error"]},
    "profile": {"type": "object"},
    "config": {"type": "object"},
    "result": {"type": ["object", "null"]},
    "error": {"type": "object", "required": ["code", "message"],
              "properties": {"code": {"type": "string"}, "message": {"type": "string"}}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "meta": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "error"}}, "required": ["status"]},
     "then": {"required": ["error"], "properties": {"result": {"type": "null"}}}},
    {"if": {"properties": {"command": {"const": "diff"}, "status": {"enum": ["ok", "partial"]}}, "required": ["command", "status"]},
     "then": {"properties": {"result": {"$ref": "#/$defs/diff"}}}},
    {"if": {"properties": {"command": {"const": "cost"}, "status": {"enum": ["ok", "partial"]}}, "required": ["command", "status"]},
     "then": {"properties": {"result": {"$ref": "#/$defs/cost"}}}},
    {"if": {"properties": {"command": {"const": "estimate"}, "status": {"enum": ["ok", "partial"]}}, "required": ["command", "status"]},
     "then": {"properties": {"result": {"$ref": "#/$defs/estimate_or_compare"}}}}
  ],
  "$defs": {
    "ge3": {"type": "object", "required": ["min", "typ", "max"],
            "properties": {"min": {"type": "number"}, "typ": {"type": "number"}, "max": {"type": "number"}}},
    "confidence": {"type": "object", "required": ["level", "reasons"],
                   "properties": {"level": {"enum": ["high", "medium", "low"]},
                                  "range_ratio": {"type": "number"},
                                  "reasons": {"type": "array", "items": {"type": "string"}}}},
    "diagnostic": {"type": "object", "required": ["code", "severity", "affects_cost", "message"],
                   "properties": {"code": {"type": "string"},
                                  "severity": {"enum": ["info", "warning", "error"]},
                                  "affects_cost": {"type": "boolean"},
                                  "side": {"enum": ["before", "after", "both"]},
                                  "file": {"type": ["string", "null"]},
                                  "line": {"type": ["integer", "null"]},
                                  "column": {"type": ["integer", "null"]},
                                  "message": {"type": "string"}}},
    "contributor": {"type": "object",
                    "required": ["file", "line", "reason", "description", "delta_ge", "instances"],
                    "properties": {"rank": {"type": "integer"}, "file": {"type": "string"}, "line": {"type": "integer"},
                                   "location_side": {"enum": ["before", "after"]},
                                   "reason": {"enum": ["added", "removed", "width", "constant", "parameter", "structure",
                                                       "architecture", "sharing", "fusion", "register", "multiplicity", "blackbox"]},
                                   "cause": {"type": ["object", "null"]},
                                   "description": {"type": "string"}, "op": {"type": "string"},
                                   "widths": {"type": "array", "items": {"type": "integer"}},
                                   "category": {"type": "string"}, "module": {"type": "string"},
                                   "instances": {"type": "integer", "minimum": 0},
                                   "delta_ge": {"$ref": "#/$defs/ge3"}, "per_instance_ge": {"$ref": "#/$defs/ge3"},
                                   "children": {"type": "array", "items": {"$ref": "#/$defs/contributor"}}}},
    "diff": {"type": "object", "required": ["verdict", "confidence", "contributors"],
             "properties": {"verdict": {"enum": ["NO_CHANGE", "NEGLIGIBLE", "INCREASE", "DECREASE", "UNCERTAIN", "NOT_COMPARABLE"]},
                            "confidence": {"$ref": "#/$defs/confidence"},
                            "top": {"type": ["string", "null"]},
                            "before": {"type": ["object", "null"]}, "after": {"type": ["object", "null"]},
                            "delta": {"type": ["object", "null"]},
                            "contributors": {"type": "array", "items": {"$ref": "#/$defs/contributor"}},
                            "others": {"type": "object", "required": ["count", "net_ge"]},
                            "by_module": {"type": "array"}, "by_category": {"type": "object"},
                            "structural": {"type": "array"}, "diagnostics_delta": {"type": "object"}}},
    "cost": {"type": "object", "required": ["top", "total", "confidence", "modules"],
             "properties": {"top": {"type": "string"}, "total": {"type": "object", "required": ["ge"]},
                            "confidence": {"$ref": "#/$defs/confidence"},
                            "modules": {"type": "array"}, "by_category": {"type": "object"}, "operations": {"type": "array"}}},
    "estimate": {"type": "object", "required": ["input", "normalized", "ge", "confidence"],
                 "properties": {"input": {"type": "object"}, "normalized": {"type": "string"},
                                "ge": {"$ref": "#/$defs/ge3"}, "architecture": {"type": "object"},
                                "breakdown": {"type": "object"}, "confidence": {"$ref": "#/$defs/confidence"}}},
    "estimate_or_compare": {"type": "object"}
  }
}
